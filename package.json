    "qoder2pi": "assets/qoder2pi",
    "workbuddy2pi": "assets/workbuddy2pi"
  },
  "files": [
    "assets/tui.js",
    "assets/qodbuddy2pi",
    "assets/qodbuddy2pi.cmd",
    "assets/qodbuddy",
