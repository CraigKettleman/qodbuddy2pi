平台：macOS 用 launchd，Linux 用 systemd --user，Windows 用登录触发的计划任务。
端口对应 pi 扩展里的 baseUrl：国内版 ${REGIONS.domestic.port} → provider workbuddy，
国际版 ${REGIONS.global.port} → provider workbuddy-global。`);
}

async function main() {
  const argv = process.argv.slice(2);
  // region 有两个来源：被 workbuddy2pi-global 调起时带的环境变量，或首参数的 global 子命令。
  // 独立命令是给人用的，global 前缀留给脚本与旧习惯，两条都留。
  if ((process.env.WORKBUDDY_REGION || '').toLowerCase() === 'global') selectRegion('global');
  if ((argv[0] || '').toLowerCase() === 'global') {
    selectRegion('global');
    argv.shift();
  }

  // 不带子命令时进交互界面；管道或重定向时退回纯文本，避免把控制字符灌进文件
  if (!argv.length && process.stdout.isTTY && process.stdin.isTTY) return tuiMain();

  const cmd = (argv[0] || 'status').toLowerCase();

  switch (cmd) {
    case 'tui':
      return tuiMain();
    case 'status':
      return cmdStatus();
    case 'start':
      return startService();
    case 'stop':
      return stopService();
    case 'restart':
      return restartService();
    case 'logs':
      return cmdLogs(Number(argv[1]) > 0 ? Number(argv[1]) : 40);
    case 'install-service':
      return installService();
    case 'uninstall-service':
      return uninstallService();
    case 'doctor':
      return cmdDoctor();
    case 'login':
      return cmdLogin();
    case 'import-session':
      return importSession(argv[1]);
    case 'check-session':
      return checkSession();
    case 'ensure-auth-key':
      return ensureAuthKey();
    case 'account': {
      const sub = argv[1];
      if (!sub) {
        const key = activeKey();
        const slots = listSlots();
        if (!slots.length) fail(`没有任何账号 slot，目录：${SLOTS_DIR}`);
        console.log('可用账号：');
        for (const s of slots) console.log(`  ${s.key === key ? '*' : ' '} ${describe(s)}`);
        return;
      }
      if (sub.toLowerCase() === 'renew') {
        const key = argv[2] || activeKey();
        if (!key) fail('无法判定当前账号，请显式指定要续期的 key');
        return renewSlot(key);
      }
      if (sub.toLowerCase() === 'add') return cmdAccountAdd();
      if (['remove', 'rm', 'del'].includes(sub.toLowerCase())) return cmdAccountRemove(argv[2]);
      return switchTo(sub);
    }
    case '-h':
    case '--help':
    case 'help':
      return usage();
    default:
      usage();
      fail(`未知子命令：${cmd}`);
  }
}

// 被 require 时（总控 qodbuddy2pi）只导出页工厂与区域表，不执行命令行入口
module.exports = { workbuddyPage, REGIONS };

if (require.main === module) main().catch((e) => fail(e && e.stack ? e.stack : String(e)));
