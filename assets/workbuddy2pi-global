#!/usr/bin/env node
/**
 * workbuddy2pi-global — 国际版入口。
 *
 * 实现与国内版共用同一份 workbuddy2pi，只是把 region 固定成 global，
 * 因此两边的子命令、帮助与交互界面完全一致，不存在第二套需要同步的实现。
 *
 * 与 `workbuddy2pi global <命令>` 等价，后者保留给脚本与旧习惯。
 */

'use strict';

process.env.WORKBUDDY_REGION = 'global';

// 主脚本被 require 时不会自动跑命令行入口（那样总控一 require 就会变成 CLI），
// 所以这里显式调它的入口。
require(require('node:path').join(__dirname, 'workbuddy2pi')).runCli();
